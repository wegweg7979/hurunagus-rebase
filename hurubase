#!/usr/bin/env bash
# hurubase — safe rebase helper for hurunagus images and other atomic Fedora/bootc distros.
#
#   hurubase --list                          list known rebase targets
#   hurubase <target> [--check] [--yes]      preflight, plan, then apply (asks first)
#   hurubase --image <ref> [...]             same, for an arbitrary image reference
#   hurubase --continue                      run the second half of a two-step rebase
#   hurubase --finish [--adopt-differs] [--fix-session]
#   hurubase --status                        what state are we in?
#   hurubase --rollback [--yes]              go back to the previous deployment
#
# Rebasing between images that ship a different desktop environment or display
# manager is not just "rpm-ostree rebase && reboot". The things that actually
# bite, and what this tool does about them:
#
#   1. Signature/policy. If /etc/containers/policy.json does not trust the
#      target's repository, the signed rebase is refused by the OS. The
#      documented workaround is: rebase to the UNSIGNED image (which installs
#      the keys and policy), reboot, then rebase to the signed one. This tool
#      reads the policy itself and only uses the two-step when it is needed.
#
#   2. A staged deployment. Rebasing on top of an already-staged update means
#      you cannot tell what you are actually booting. Refused.
#
#   3. The /etc/skel gap. An atomic rebase NEVER seeds /etc/skel into an
#      existing $HOME, so the new desktop's configs simply never arrive and the
#      new session looks broken or bare. `--finish` (after the reboot) adopts
#      the target's /etc/skel: files that are MISSING are written, files that
#      exist are left alone, and files that differ are REPORTED (pass
#      --adopt-differs to back them up and replace them). Nothing is ever
#      deleted, and a per-target never-clobber list is always honoured.
#
#   4. A stale session choice. ~/.config/sddm/state.conf (LastSession=) and
#      /var/lib/AccountsService/users/<user> (XSession=) keep naming the OLD
#      desktop's session after the rebase, so GDM/SDDM try to launch a session
#      the target does not ship and you get a black screen or a bounce back to
#      the greeter. Reported by default; --fix-session (root) rewrites those two
#      files after backing them up.
#
# What this tool NEVER does: delete anything, prune a deployment, rewrite
# /etc/containers/policy.json or any other system file, touch a file outside
# $HOME during --finish, reboot without asking, or silently proceed past a
# refusal.
#
# NVIDIA variants are deliberately unsupported: any reference whose repository
# or tag contains "nvidia" is refused (exit 1), not warned about.
#
# Exit codes: 0 success, 1 refused/failed, 2 usage error.
#
# Environment seams (also the test surface):
#   HURUBASE_ETC             /etc
#   HURUBASE_OS_RELEASE      /etc/os-release
#   HURUBASE_POLICY          /etc/containers/policy.json
#   HURUBASE_HOME            the $HOME to operate on (default: $HOME, or SUDO_USER's)
#   HURUBASE_SKEL            /etc/skel
#   HURUBASE_SESSIONS_DIR    /usr/share/wayland-sessions
#   HURUBASE_ACCOUNTS_DIR    /var/lib/AccountsService/users
#   HURUBASE_VAR_STATE       /var/lib/hurubase   (survives a rebase: /var is not replaced)
#   HURUBASE_RPM_OSTREE      rpm-ostree      HURUBASE_BOOTC     bootc
#   HURUBASE_SKOPEO          skopeo          HURUBASE_SYSTEMCTL systemctl
#   HURUBASE_MOKUTIL         mokutil         HURUBASE_DF        df
#   HURUBASE_OSTREE_JSON     fixture for `rpm-ostree status --json`
#   HURUBASE_BOOTC_JSON      fixture for `bootc status --json`
#   HURUBASE_SKOPEO_JSON     fixture for `skopeo inspect --no-tags docker://<ref>`
#   HURUBASE_EUID            override EUID (root gate)
#   HURUBASE_ASSUME_YES=1    skip the confirmation prompt
#   HURUBASE_DRY_RUN=1       print the commands instead of running them
#   HURUBASE_TTY             /dev/tty
#   HURUBASE_BOOT_PART / HURUBASE_VAR_PART / HURUBASE_MIN_FREE_{VAR,BOOT}_MB
#
# Requires: bash, python3 (JSON), and for an apply either rpm-ostree or bootc.

set -euo pipefail

HURUBASE_VERSION="0.1.0"
PROG="hurubase"

ETC=${HURUBASE_ETC:-/etc}
OS_RELEASE=${HURUBASE_OS_RELEASE:-$ETC/os-release}
POLICY=${HURUBASE_POLICY:-$ETC/containers/policy.json}
SKEL=${HURUBASE_SKEL:-$ETC/skel}
SESSIONS_DIR=${HURUBASE_SESSIONS_DIR:-/usr/share/wayland-sessions}
ACCOUNTS_DIR=${HURUBASE_ACCOUNTS_DIR:-/var/lib/AccountsService/users}
VAR_STATE=${HURUBASE_VAR_STATE:-/var/lib/hurubase}
RPM_OSTREE=${HURUBASE_RPM_OSTREE:-rpm-ostree}
BOOTC=${HURUBASE_BOOTC:-bootc}
SKOPEO=${HURUBASE_SKOPEO:-skopeo}
SYSTEMCTL=${HURUBASE_SYSTEMCTL:-systemctl}
MOKUTIL=${HURUBASE_MOKUTIL:-mokutil}
DF=${HURUBASE_DF:-df}
TTY_DEV=${HURUBASE_TTY:-/dev/tty}
OSTREE_JSON=${HURUBASE_OSTREE_JSON:-}
BOOTC_JSON=${HURUBASE_BOOTC_JSON:-}
SKOPEO_JSON=${HURUBASE_SKOPEO_JSON:-}
EUID_OVERRIDE=${HURUBASE_EUID:-}
ASSUME_YES=${HURUBASE_ASSUME_YES:-0}
DRY_RUN=${HURUBASE_DRY_RUN:-0}
BOOT_PART=${HURUBASE_BOOT_PART:-/boot}
VAR_PART=${HURUBASE_VAR_PART:-/var}
MIN_FREE_VAR_MB=${HURUBASE_MIN_FREE_VAR_MB:-8192}
MIN_FREE_BOOT_MB=${HURUBASE_MIN_FREE_BOOT_MB:-256}

WARNINGS=()
REFUSALS=()
NOTES=()
BACKUPS=()
STEP_DONE=0
COMMAND=""
APPLY_CMD=()

# --------------------------------------------------------------------------- #
# output
# --------------------------------------------------------------------------- #

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_DIM=$'\033[2m'
else
  C_RESET=""; C_BOLD=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_DIM=""
fi

say() { printf '%s\n' "$*"; }
head2() { printf '\n%s== %s%s\n' "$C_BOLD" "$*" "$C_RESET"; }
ok() { printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
info() { printf '  %s•%s %s\n' "$C_DIM" "$C_RESET" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
err() { printf '%s%serror:%s %s\n' "$C_BOLD" "$C_RED" "$C_RESET" "$*" >&2; }

die() { err "$@"; exit 1; }
usage_die() { err "$@"; say "Try '$PROG --help'." >&2; exit 2; }

refuse() { REFUSALS+=("$*"); }
add_warning() { WARNINGS+=("$*"); }
add_note() { NOTES+=("$*"); }

run() {
  if [[ $DRY_RUN == 1 ]]; then
    printf '  %s$ %s%s\n' "$C_DIM" "$*" "$C_RESET"
    return 0
  fi
  "$@"
}

confirm() {
  local prompt=$1 answer
  [[ $ASSUME_YES == 1 ]] && { info "auto-confirmed (--yes)"; return 0; }
  if [[ ! -e $TTY_DEV ]]; then
    err "no terminal available for confirmation; re-run with --yes if you mean it"
    return 1
  fi
  printf '%s [y/N] ' "$prompt" >"$TTY_DEV"
  read -r answer <"$TTY_DEV" || answer=""
  case "${answer,,}" in y | yes) return 0 ;; *) return 1 ;; esac
}

