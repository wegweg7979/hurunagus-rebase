    V_KEEP=".config/niri/local.kdl"
    ;;
  bluefin)
    V_REF="ghcr.io/ublue-os/bluefin:latest"
    V_DE="GNOME"
    V_DM="gdm"
    V_SESSION=""
    V_APPLY="rpm-ostree"
    V_DESC="Universal Blue Bluefin — GNOME desktop"
    V_NOTES=$'Universal Blue family: signed with the ublue-os key, policy entry ghcr.io/ublue-os.'
    ;;
  bazzite)
    V_REF="ghcr.io/ublue-os/bazzite:latest"
    V_DE="KDE Plasma"
    V_DM="sddm"
    V_SESSION=""
    V_APPLY="rpm-ostree"
    V_DESC="Universal Blue Bazzite — KDE Plasma (gaming)"
    V_NOTES=$'Universal Blue family: signed with the ublue-os key, policy entry ghcr.io/ublue-os.'
    ;;
  bazzite-gnome)
    V_REF="ghcr.io/ublue-os/bazzite-gnome:latest"
    V_DE="GNOME"
    V_DM="gdm"
    V_SESSION=""
    V_APPLY="rpm-ostree"
    V_DESC="Universal Blue Bazzite GNOME — the GNOME flavour of Bazzite"
    V_NOTES=$'Universal Blue family: signed with the ublue-os key, policy entry ghcr.io/ublue-os.'
    ;;
  aurora)
    V_REF="ghcr.io/ublue-os/aurora:latest"
    V_DE="KDE Plasma"
    V_DM="sddm"
    V_SESSION=""
    V_APPLY="rpm-ostree"
