variant_list() {
  printf '%-22s %-18s %-9s %-11s %s\n' TARGET DESKTOP DM APPLY IMAGE
  local n
  while read -r n; do
    variant_load "$n" || continue
    local mark=""
    [[ $n == hurunagus-hyprland ]] && mark="[flagship]"
    printf '%-22s %-18s %-9s %-11s %s %s\n' "$n" "$V_DE" "$V_DM" "$V_APPLY" "$V_REF" "$mark"
  done < <(variant_names)
  printf '\n%sTargets are chosen by name; use --image <ref> for anything else.%s\n' "$C_DIM" "$C_RESET"
  printf '%sUnsupported by design: any *-nvidia* image (refused), and the retired\nhurunagus, hurunagus-umbriel and hurunagus-hyprland-dms images.%s\n' "$C_DIM" "$C_RESET"
}

# --------------------------------------------------------------------------- #
# small helpers
# --------------------------------------------------------------------------- #

normalize_ref() {
  local r=$1
  r=${r#ostree-image-signed:docker://}
  r=${r#ostree-unverified-registry:}
  r=${r#ostree-unverified-image:docker://}
  r=${r#ostree-unverified-image:registry:}
  r=${r#docker://}
  printf '%s' "$r"
}

repo_of_ref() { # ghcr.io/owner/name:tag -> ghcr.io/owner/name
  local r
  r=$(normalize_ref "$1")
  printf '%s' "${r%%:*}"
}

is_nvidia_ref() {
  local r
  r=$(normalize_ref "$1")
  [[ ${r,,} == *nvidia* ]]
}

validate_ref() {
  local r=$1
  [[ -n $r ]] || return 1
  [[ $r == */*/* ]] || return 1
  [[ $r != *" "* ]] || return 1
  return 0
}

free_mb() {
  local path=$1 out
  # `df -Pk` prints 1K blocks in field 4 (Available). -P and --output are
  # mutually exclusive in coreutils df, so do not reach for --output here.
  out=$("$DF" -Pk "$path" 2>/dev/null | awk 'NR==2 {print $4}') || return 1
  [[ $out =~ ^[0-9]+$ ]] || return 1
  printf '%d' $((out / 1024))
}

os_release_value() {
  local key=$1
  [[ -r $OS_RELEASE ]] || return 0
  (
    set +u
    . "$OS_RELEASE" >/dev/null 2>&1 || exit 0
    case "$key" in
    ID) printf '%s' "${ID:-}" ;;
    NAME) printf '%s' "${NAME:-}" ;;
    VERSION) printf '%s' "${VERSION:-}" ;;
    VERSION_ID) printf '%s' "${VERSION_ID:-}" ;;
    esac
  )
}

have() { command -v "$1" >/dev/null 2>&1; }

am_root() {
  if [[ -n $EUID_OVERRIDE ]]; then [[ $EUID_OVERRIDE == 0 ]]; else [[ ${EUID:-$(id -u)} -eq 0 ]]; fi
}

target_home() {
  if [[ -n ${HURUBASE_HOME:-} ]]; then printf '%s' "$HURUBASE_HOME"; return; fi
  if am_root && [[ -n ${SUDO_USER:-} ]] && have getent; then
    local h
    h=$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6) || h=""
    if [[ -n $h ]]; then printf '%s' "$h"; return; fi
  fi
  printf '%s' "${HOME:-/root}"
}

home_owner() { if am_root && [[ -n ${SUDO_USER:-} ]]; then printf '%s' "$SUDO_USER"; fi; }

# --------------------------------------------------------------------------- #
# system state
# --------------------------------------------------------------------------- #

BOOTED_REF=""; BOOTED_VERSION=""; STAGED_COUNT=0; DEPLOY_COUNT=0

load_deployments() {
  local json=""
  if [[ -n $OSTREE_JSON ]]; then
    json=$OSTREE_JSON
    [[ -r $json ]] || die "HURUBASE_OSTREE_JSON is unreadable: $json"
  elif have "$RPM_OSTREE"; then
    json=$("$RPM_OSTREE" status --json 2>/dev/null) || json=""
  fi
  if [[ -z $json ]]; then
    if [[ -n $BOOTC_JSON ]]; then
      json=$BOOTC_JSON
      [[ -r $json ]] || die "HURUBASE_BOOTC_JSON is unreadable: $json"
      load_bootc_json "$json"
      return 0
    fi
    if have "$BOOTC"; then
      json=$("$BOOTC" status --json 2>/dev/null) || json=""
      if [[ -n $json ]]; then load_bootc_json <<<"$json"; return 0; fi
    fi
    die "cannot read the deployment list (no rpm-ostree status, no bootc status)"
  fi
  load_ostree_json "$json"
}

load_ostree_json() {
  local out
  out=$(python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("|||0|0"); raise SystemExit(0)
deps = d.get("deployments", []) or []
booted = [x for x in deps if x.get("booted")]
staged = [x for x in deps if x.get("staged") and not x.get("booted")]
b = booted[0] if booted else {}
ref = (b.get("container-image-reference") or b.get("origin") or "").strip()
print("|".join([ref, str(b.get("version") or "").strip(), str(len(staged)), str(len(deps))]))
' <<<"$1")
  IFS='|' read -r BOOTED_REF BOOTED_VERSION STAGED_COUNT DEPLOY_COUNT <<<"$out"
}

load_bootc_json() {
  local out
  out=$(python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("|||0|0"); raise SystemExit(0)
st = d.get("status", {}) or {}
b = (st.get("booted") or {}).get("image") or {}
ref = (b.get("imageRef") or b.get("imageDigest") or "").strip()
ver = str(b.get("version") or "").strip()
staged = 1 if st.get("staged") else 0
print("|".join([ref, ver, str(staged), "1"]))
' <<<"$1")
  IFS='|' read -r BOOTED_REF BOOTED_VERSION STAGED_COUNT DEPLOY_COUNT <<<"$out"
}

dm_current() {
  local alias="$ETC/systemd/system/display-manager.service" t u
  if [[ -L $alias ]]; then
    t=$(readlink "$alias" 2>/dev/null || true)
    [[ -n $t ]] && { printf '%s' "${t##*/}"; return; }
  fi
  for u in sddm gdm greetd lightdm ly; do
    if have "$SYSTEMCTL" && "$SYSTEMCTL" is-enabled "$u.service" >/dev/null 2>&1; then
      printf '%s.service' "$u"; return
    fi
  done
  printf 'unknown'
}

dm_enabled_units() {
  local u out=""
  for u in sddm gdm gdm3 lightdm greetd ly; do
    if have "$SYSTEMCTL" && "$SYSTEMCTL" is-enabled "$u.service" >/dev/null 2>&1; then
      out+="$u "
    fi
  done
  printf '%s' "${out% }"
}

current_sessions() {
  local f out=""
  for f in "$SESSIONS_DIR"/*.desktop; do
    [[ -e $f ]] || continue
    f=${f##*/}
    out+="${f%.desktop} "
  done
  printf '%s' "${out% }"
}

recorded_sessions() {
  local f v
  for f in "$ACCOUNTS_DIR"/*; do
    [[ -f $f ]] || continue
    v=$(awk -F= '/^XSession=/{print $2; exit}' "$f" 2>/dev/null || true)
    [[ -n $v ]] && printf '%s: XSession=%s\n' "${f##*/}" "$v"
  done
  f="$(target_home)/.config/sddm/state.conf"
  if [[ -f $f ]]; then
    v=$(awk -F= '/^LastSession=/{print $2; exit}' "$f" 2>/dev/null || true)
    [[ -n $v ]] && printf 'sddm state.conf: LastSession=%s\n' "$v"
  fi
}

secure_boot_state() {
  have "$MOKUTIL" || { printf 'unknown'; return; }
  local out
  out=$("$MOKUTIL" --sb-state 2>/dev/null || true)
  case "$out" in
  *enabled*) printf 'enabled' ;;
  *disabled*) printf 'disabled' ;;
  *) printf 'unknown' ;;
  esac
}

# --------------------------------------------------------------------------- #
# target inspection (no pull: registry metadata only)
# --------------------------------------------------------------------------- #

T_DIGEST=""; T_VERSION=""; T_CREATED=""; T_LABELS=""

inspect_target() {
  local ref=$1 out
  if [[ -n $SKOPEO_JSON ]]; then
    [[ -r $SKOPEO_JSON ]] || die "HURUBASE_SKOPEO_JSON is unreadable: $SKOPEO_JSON"
    out=$(cat "$SKOPEO_JSON")
  else
    have "$SKOPEO" || die "skopeo is required to resolve the target image"
    if ! out=$("$SKOPEO" inspect --no-tags "docker://$ref" 2>&1); then
      return 1
    fi
  fi
  local parsed
  parsed=$(python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("|||"); raise SystemExit(0)
lab = d.get("Labels") or {}
print("|".join([str(d.get("Digest") or ""),
                str(lab.get("org.opencontainers.image.version") or ""),
                str(lab.get("org.opencontainers.image.created") or ""),
                ",".join(sorted(lab.keys()))]))
' <<<"$out")
  IFS='|' read -r T_DIGEST T_VERSION T_CREATED T_LABELS <<<"$parsed"
  return 0
}

major_of_version() {
  local v=$1
  if [[ $v =~ ^([0-9]+) ]]; then printf '%s' "${BASH_REMATCH[1]}"; fi
  return 0
}

date_of_version() {
  local v=$1
  if [[ $v =~ ([0-9]{8}) ]]; then printf '%s' "${BASH_REMATCH[1]}"; fi
  return 0
}

# permit:<why> | twostep:<why>
policy_verdict() {
  local repo=$1
  if [[ ! -r $POLICY ]]; then
    printf 'twostep:no-policy-file'
    return
  fi
  python3 - "$POLICY" "$repo" <<'PY'
import json, os, sys
path, repo = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    print("twostep:unreadable-policy"); raise SystemExit(0)
docker = ((d.get("transports") or {}).get("docker") or {})
cands = [k for k in docker if k and (repo == k or repo.startswith(k + "/"))]
key = max(cands, key=len) if cands else ""
entry = docker.get(key)
if entry is None:
    print("twostep:no-entry-for-" + (key or repo)); raise SystemExit(0)
verdicts = []
for e in entry:
    t = e.get("type")
    if t == "insecureAcceptAnything":
        verdicts.append("permit:permissive" + ("" if key else " (empty-repo fallback)"))
    elif t == "sigstoreSigned":
        kps = e.get("keyPaths") or ([e.get("keyPath")] if e.get("keyPath") else [])
        missing = [k for k in kps if not os.path.exists(k)]
        verdicts.append("permit:sigstoreSigned" if not missing else "twostep:missing-key")
    elif t == "signedBy":
        kp = e.get("keyPath") or "/etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release"
        verdicts.append("permit:signedBy" if os.path.exists(kp) else "twostep:missing-key")
    else:
        verdicts.append("twostep:" + str(t))
order = {"permit": 0, "twostep": 1}
best = sorted(verdicts, key=lambda v: (0 if v.startswith("permit") else 1, v))[0] if verdicts else "twostep:reject"
print(best)
PY
}

# --------------------------------------------------------------------------- #
# preflight
# --------------------------------------------------------------------------- #

APPLY_MODE=""  # direct | two-step
APPLY_TOOL=""  # rpm-ostree | bootc

choose_tool() {
  if have "$RPM_OSTREE"; then
    APPLY_TOOL=rpm-ostree
  elif have "$BOOTC"; then
    APPLY_TOOL=bootc
  else
    APPLY_TOOL=""
  fi
}

preflight() {
  local ref=$1 repo target_major running_major
  repo=$(repo_of_ref "$ref")

  head2 "Running system"
  local name
  name=$(os_release_value NAME)
  info "distro      ${name:-unknown} $(os_release_value VERSION_ID)"
  local osver
  osver=$(os_release_value VERSION)
  info "os-release  ${name:-unknown} $(os_release_value VERSION_ID) (${osver})"
  info "deployment  ${BOOTED_REF:-unknown} ${BOOTED_VERSION:+($BOOTED_VERSION)}"
  if ((STAGED_COUNT > 0)); then
    info "staged      yes"
  else
    info "staged      none"
  fi
  local dm
  dm=$(dm_current)
  info "display-mgr $dm (display-manager.service)"
  local en
  en=$(dm_enabled_units)
  [[ -n $en ]] && info "enabled DMs $en"
  info "sessions    $(current_sessions)"
  local rec
  while read -r rec; do [[ -n $rec ]] && info "session-pick $rec"; done < <(recorded_sessions)
  info "secure boot $(secure_boot_state)"

  head2 "Target"
  info "ref         $ref"
  info "desktop     $V_DE"
  info "display-mgr $V_DM"
  [[ -n $V_SESSION ]] && info "session     $V_SESSION"
  if [[ -n $T_DIGEST ]]; then info "digest      $T_DIGEST"; fi
  if [[ -n $T_VERSION ]]; then info "version     $T_VERSION"; fi
  if [[ -n $T_CREATED ]]; then info "built       $T_CREATED"; fi
  [[ -n $V_DESC ]] && info "what        $V_DESC"

  # ---- refusals -----------------------------------------------------------
  if is_nvidia_ref "$ref"; then
    refuse "NVIDIA images are not supported by this tool. Pick a stock image (the target must not contain 'nvidia')."
  fi
  if ((STAGED_COUNT > 0)); then
    refuse "a deployment is already staged: reboot to apply it first (or 'rpm-ostree cleanup -p'), then rebase."
  fi
  local var_mb boot_mb
  var_mb=$(free_mb "$VAR_PART" || true)
  boot_mb=$(free_mb "$BOOT_PART" || true)
  if [[ -n $var_mb && $var_mb -lt $MIN_FREE_VAR_MB ]]; then
    refuse "$VAR_PART has ${var_mb} MiB free; at least ${MIN_FREE_VAR_MB} MiB is required for a rebase."
  fi
  if [[ -n $boot_mb && $boot_mb -lt $MIN_FREE_BOOT_MB ]]; then
    refuse "$BOOT_PART has ${boot_mb} MiB free; at least ${MIN_FREE_BOOT_MB} MiB is required."
  fi
  if [[ -n $var_mb ]]; then
    info "free space  ${var_mb} MiB on $VAR_PART, ${boot_mb:-?} MiB on $BOOT_PART"
  else
    add_warning "could not determine the free space on $VAR_PART (df failed), so the space guard did not run."
  fi

  local verdict
  verdict=$(policy_verdict "$repo")

  # ---- apply path ---------------------------------------------------------
  choose_tool
  case "$verdict" in
  permit:*)
    APPLY_MODE=direct
    add_note "policy.json already permits $repo (${verdict#permit:}) — the signed path is used directly, one step."
    ;;
  *)
    APPLY_MODE=two-step
    add_note "policy.json does not trust $repo (${verdict#twostep:}) — the documented two-step is used: unsigned rebase, reboot, then the signed rebase."
    ;;
  esac

  if [[ $APPLY_MODE == direct ]]; then
    if [[ $APPLY_TOOL == bootc && $V_APPLY == bootc ]]; then
      APPLY_CMD=("$BOOTC" switch "$ref")
    elif [[ $APPLY_TOOL == rpm-ostree ]]; then
      APPLY_CMD=("$RPM_OSTREE" rebase "ostree-image-signed:docker://$ref")
    elif [[ $APPLY_TOOL == bootc ]]; then
      APPLY_CMD=("$BOOTC" switch "$ref")
    else
      refuse "neither rpm-ostree nor bootc is available to apply the rebase."
    fi
  else
    if [[ $APPLY_TOOL == rpm-ostree ]]; then
      APPLY_CMD=("$RPM_OSTREE" rebase "ostree-unverified-registry:$ref")
    else
      refuse "the unsigned first step needs rpm-ostree, which is not installed; add the target's key and policy entry by hand first."
    fi
  fi

  # ---- version direction --------------------------------------------------
  running_major=$(os_release_value VERSION_ID)
  target_major=$(major_of_version "$T_VERSION")
  if [[ -n $target_major && -n $running_major && $target_major != "$running_major" ]]; then
    if ((target_major > running_major)); then
      add_warning "target is Fedora $target_major, you are on Fedora $running_major: this is a MAJOR version upgrade, not a routine update."
    else
      add_warning "target is Fedora $target_major but you are on Fedora $running_major: this rebase moves the OS BACKWARDS."
    fi
  fi
  local tdate rdate
  tdate=$(date_of_version "$T_VERSION")
  rdate=$(date_of_version "$BOOTED_VERSION")
  if [[ -n $tdate && -n $rdate && $tdate -lt $rdate ]]; then
    add_warning "target build ($tdate) is older than the running deployment ($rdate) — a rebase to it is a downgrade of the image, not an update."
  fi

  # ---- desktop / display manager ------------------------------------------
  local cur_dm=${dm:-unknown}
  case "$cur_dm" in
  *"$V_DM"*) ;;
  unknown) ;;
  *) [[ $V_DM == unknown ]] || add_warning "display manager changes: $cur_dm -> ${V_DM}.service. A locally-enabled $cur_dm is left in /etc by the rebase; if $V_DM is the one the target ships, $cur_dm's unit simply disappears with the old image." ;;
  esac
  if [[ -n $V_SESSION ]]; then
    local s
    for s in $(current_sessions); do
      [[ $s == "$V_SESSION" ]] && add_warning "the running system already ships a '${V_SESSION}' session file, which the target replaces."
    done
  fi
  while read -r rec; do
    [[ -z $rec ]] && continue
    local picked=${rec#*: *Session=}
    if [[ -n $V_SESSION && $picked != "$V_SESSION" ]]; then
      add_warning "recorded session '$picked' ($rec) will name a session the target may not ship — run '$PROG --finish --fix-session' after the reboot to reset it to '$V_SESSION'."
    fi
  done < <(recorded_sessions)

  if [[ $(secure_boot_state) == enabled && $repo == *wegweg7979/* ]]; then
    add_warning "Secure Boot is enabled and hurunagus images carry the unsigned kernel-cachyos kernel: a MOK must be enrolled for the target to boot."
  fi
  if [[ $verdict == permit:permissive* ]]; then
    add_warning "policy.json accepts this repository without verifying a signature (${verdict#permit:}) — nothing is checked about who built the image."
  fi
}

print_findings() {
  local i
  if ((${#NOTES[@]})); then
    head2 "Plan"
    for i in "${NOTES[@]}"; do info "$i"; done
    if [[ $APPLY_MODE == two-step ]]; then
      info "step 1  ${APPLY_CMD[*]}"
      info "step 2  reboot, then '$PROG --continue' (signed rebase)"
      info "step 3  reboot, then '$PROG --finish' (adopt the new desktop's /etc/skel)"
    else
      info "step 1  ${APPLY_CMD[*]}"
      info "step 2  reboot, then '$PROG --finish' (adopt the new desktop's /etc/skel)"
    fi
    info "rollback '$PROG --rollback' (the previous deployment is never pruned by this tool)"
  fi
  if ((${#WARNINGS[@]})); then
    head2 "Warnings"
    for i in "${WARNINGS[@]}"; do warn "$i"; done
  fi
  if ((${#REFUSALS[@]})); then
    head2 "Refused"
    for i in "${REFUSALS[@]}"; do err "$i"; done
  fi
  if [[ -n $V_NOTES ]]; then
    head2 "Target notes"
    while IFS= read -r i; do [[ -n $i ]] && info "$i"; done <<<"$V_NOTES"
  fi
}

# --------------------------------------------------------------------------- #
# state
# --------------------------------------------------------------------------- #

state_file() { printf '%s/state' "$VAR_STATE"; }

state_write() {
  [[ $DRY_RUN == 1 ]] && { info "(dry run: state not written)"; return 0; }
  mkdir -p "$VAR_STATE"
  {
    printf 'step=%s\n' "$1"
    printf 'target=%s\n' "$V_NAME"
    printf 'ref=%s\n' "$2"
    printf 'digest=%s\n' "$T_DIGEST"
    printf 'desktop=%s\n' "$V_DE"
    printf 'dm=%s\n' "$V_DM"
    printf 'session=%s\n' "$V_SESSION"
    printf 'started=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"$(state_file)"
  chmod 600 "$(state_file)"
  info "state written to $(state_file) (step $1)"
}

state_get() {
  local f
  f=$(state_file)
  [[ -r $f ]] || return 1
  awk -F= -v k="$1" '$1==k {sub(/^[^=]*=/, ""); print; exit}' "$f"
}

state_clear() {
  [[ $DRY_RUN == 1 ]] && return 0
  rm -f "$(state_file)"
}

# --------------------------------------------------------------------------- #
# apply
# --------------------------------------------------------------------------- #

do_apply() {
  local ref=$1
  am_root || die "applying a rebase needs root: re-run as 'sudo $PROG $*'"
  if [[ -z $APPLY_TOOL ]]; then
    refuse "neither rpm-ostree nor bootc is available; cannot apply."
    print_findings
    exit 1
  fi
  if ((${#REFUSALS[@]})); then print_findings; die "refusing to rebase: see the refusals above."; fi
  confirm "Apply this rebase to $ref now?" || die "aborted by user; nothing was changed."
  head2 "Applying"
  run "${APPLY_CMD[@]}"
  if [[ $APPLY_MODE == two-step ]]; then
    state_write 1 "$ref"
    head2 "Next"
    info "reboot, then run '$PROG --continue' to install the signed target."
  else
    state_write 2 "$ref"
    head2 "Next"
    info "reboot, then run '$PROG --finish' to adopt the new desktop's /etc/skel."
  fi
}

cmd_continue() {
  local want_ref want_digest step booted_n
  state_get target >/dev/null 2>&1 || die "no rebase in progress (no $(state_file)); start one with '$PROG <target>'."
  step=$(state_get step || true)
  want_ref=$(state_get ref || true)
  want_digest=$(state_get digest || true)
  variant_load "$(state_get target)" || die "the recorded target is no longer in the table"
  load_deployments
  booted_n=$(normalize_ref "$BOOTED_REF")
  if [[ $booted_n != "$want_ref" ]]; then
    die "the booted deployment is '$booted_n', not the rebase target '$want_ref' — reboot into it first (or run '$PROG --status')."
  fi
  case "$step" in
  2) say "Already on the target with the signed image applied. Run '$PROG --finish'."; return 0 ;;
  1) ;;
  *) die "unexpected state: step=$step" ;;
  esac
  am_root || die "the second step needs root: re-run as 'sudo $PROG --continue'"
  inspect_target "$want_ref" || die "cannot resolve $want_ref (offline?)"
  if [[ -n $want_digest && -n $T_DIGEST && $want_digest != "$T_DIGEST" ]]; then
    if [[ ${FORCE:-0} != 1 ]]; then
      die "'latest' now resolves to $T_DIGEST, not the $want_digest recorded before the reboot — the tag moved (a same-commit rebuild). Re-run with --force to accept the new content."
    fi
    warn "digest moved: $want_digest -> $T_DIGEST (accepted because of --force)"
  fi
  head2 "Second step"
  info "signed rebase onto $want_ref"
  confirm "Re-rebase to the signed image now?" || die "aborted; you stay on the unsigned deployment."
  choose_tool
  if [[ $APPLY_TOOL == rpm-ostree ]]; then
    run "$RPM_OSTREE" rebase "ostree-image-signed:docker://$want_ref"
  elif [[ $APPLY_TOOL == bootc ]]; then
    run "$BOOTC" switch "$want_ref"
  else
    die "neither rpm-ostree nor bootc is available; cannot complete the rebase."
  fi
  state_write 2 "$want_ref"
  head2 "Next"
  info "reboot, then run '$PROG --finish'."
}

# --------------------------------------------------------------------------- #
# finish: adopt /etc/skel + report the desktop state
# --------------------------------------------------------------------------- #

ADOPT_DIFFERS=0
FIX_SESSION=0
ADOPT=1

adopt_skel() {
  local skel=$1 home=$2 created=0 same=0 differs=0 kept=0 skipped=0 rel src dst target dir
  [[ -d $skel ]] || { warn "$skel does not exist; nothing to adopt."; return 0; }
  [[ -d $home ]] || die "the target home '$home' does not exist."

  while IFS= read -r rel; do
    case "$rel" in
    /* | *..*)
      skipped=$((skipped + 1))
      warn "skipping '$rel' (unsafe path)"
      continue
      ;;
    esac
    local keep=0 k
    if [[ -n ${V_KEEP:-} ]]; then
      while IFS= read -r k; do
        [[ -n $k && $rel == "$k" ]] && keep=1
      done <<<"$V_KEEP"
    fi
    if ((keep)); then
      kept=$((kept + 1))
      info "kept (never-clobber): ~/$rel"
      continue
    fi
    src="$skel/$rel"
    dst="$home/$rel"
    if [[ -L $src ]]; then
      target=$(readlink "$src")
      if [[ -L $dst ]]; then
        if [[ $(readlink "$dst") == "$target" ]]; then
          same=$((same + 1))
        else
          differs=$((differs + 1))
          info "differs (symlink target): ~/$rel"
        fi
      elif [[ -e $dst ]]; then
        differs=$((differs + 1))
        info "differs (a real file already exists): ~/$rel"
      else
        dir=${dst%/*}
        [[ $dir == "$dst" ]] && dir=$home
        run mkdir -p "$dir"
        run ln -s "$target" "$dst"
        created=$((created + 1))
        info "created symlink: ~/$rel -> $target"
      fi
      continue
    fi
    if [[ -d $src ]]; then
      if [[ ! -e $dst ]]; then
        run mkdir -p "$dst"
        created=$((created + 1))
      fi
      continue
    fi
    if [[ ! -e $dst && ! -L $dst ]]; then
      dir=${dst%/*}
      [[ $dir == "$dst" ]] && dir=$home
      run mkdir -p "$dir"
      run cp -a "$src" "$dst"
      created=$((created + 1))
      info "created: ~/$rel"
    elif cmp -s "$src" "$dst" 2>/dev/null; then
      same=$((same + 1))
    else
      differs=$((differs + 1))
      if [[ $ADOPT_DIFFERS == 1 ]]; then
        backup_file "$dst"
        run cp -a "$src" "$dst"
        info "replaced (backed up): ~/$rel"
      else
        info "differs, left alone: ~/$rel"
      fi
    fi
  done < <(cd "$skel" && find . -mindepth 1 2>/dev/null | sed 's|^\./||' | sort)

  head2 "Adoption"
  info "created $created, already identical $same, differs $differs, never-clobber $kept, skipped $skipped"
  if ((differs > 0)) && [[ $ADOPT_DIFFERS == 0 ]]; then
    info "the differing files are your own settings; re-run with --adopt-differs to back them up and take the target's copies."
  fi
}

backup_file() {
  local f=$1 stamp b
  stamp=$(date -u +%Y%m%d%H%M%S)
  b="$f.pre-rebase-$stamp"
  run cp -a "$f" "$b"
  BACKUPS+=("$b")
  info "backed up: ${f} -> ${b}"
}

fix_session() {
  local home session f v
  home=$(target_home)
  session=$V_SESSION
  [[ -n $session ]] || die "the target does not declare a session name; nothing to set."
  am_root || die "--fix-session needs root to write /var/lib/AccountsService: re-run as 'sudo $PROG --finish --fix-session'."
  head2 "Session reset"
  for f in "$ACCOUNTS_DIR"/*; do
    [[ -f $f ]] || continue
    v=$(awk -F= '/^XSession=/{print $2; exit}' "$f" 2>/dev/null || true)
    [[ $v == "$session" ]] && { info "already $session: $f"; continue; }
    if [[ -z $v ]] && ! grep -q '^XSession=' "$f"; then
      backup_file "$f"
      run sed -i "/^\[User\]/a XSession=$session" "$f"
    else
      backup_file "$f"
      run sed -i "s/^XSession=.*/XSession=$session/" "$f"
    fi
    info "set XSession=$session in $f"
  done
  f="$home/.config/sddm/state.conf"
  if [[ -f $f ]]; then
    v=$(awk -F= '/^LastSession=/{print $2; exit}' "$f" 2>/dev/null || true)
    if [[ $v != "$session" ]]; then
      backup_file "$f"
      if grep -q '^LastSession=' "$f"; then
        run sed -i "s/^LastSession=.*/LastSession=$session/" "$f"
      else
        run sh -c "printf '%s\n' 'LastSession=$session' >> '$f'"
      fi
      info "set LastSession=$session in $f"
    else
      info "already $session: $f"
    fi
  fi
}

cmd_finish() {
  local want_ref want_step booted_n home
  want_ref=$(state_get ref || true)
  want_step=$(state_get step || true)
  load_deployments
  booted_n=$(normalize_ref "$BOOTED_REF")
  if [[ -n $want_ref && $booted_n != "$want_ref" ]]; then
    die "the booted deployment is '$booted_n', not the recorded target '$want_ref' — run '$PROG --status', or start over with '$PROG <target>'."
  fi
  if [[ -z $want_ref ]]; then
    warn "no rebase state on this system; adopting /etc/skel based on the name you give, not on a recorded target."
    [[ -n ${FINISH_TARGET:-} ]] || die "pass a target name ('$PROG --finish <target>') or start a rebase first."
    variant_load "$FINISH_TARGET" || die "unknown target: $FINISH_TARGET"
  else
    variant_load "$(state_get target)" || die "the recorded target is no longer in the table"
  fi

  home=$(target_home)
  if [[ $ADOPT == 1 ]]; then
    adopt_skel "$SKEL" "$home"
  else
    head2 "Adoption"
    info "skipped (--no-adopt): nothing in $home was changed."
  fi
  if [[ $FIX_SESSION == 1 ]]; then
    fix_session
  else
    local rec
    head2 "Session / display manager"
    info "display-manager.service -> $(dm_current)"
    info "sessions available: $(current_sessions)"
    while read -r rec; do [[ -n $rec ]] && info "recorded: $rec"; done < <(recorded_sessions)
    info "if login lands on a black screen or bounces back, the recorded session is stale:"
    info "  sudo $PROG --finish --fix-session   (resets it to '${V_SESSION:-<target default>}')"
  fi
  if [[ -n $V_NOTES ]]; then
    head2 "Target notes"
    local i
    while IFS= read -r i; do [[ -n $i ]] && info "$i"; done <<<"$V_NOTES"
  fi
  if ((${#BACKUPS[@]})); then
    head2 "Backups made"
    local b
    for b in "${BACKUPS[@]}"; do info "$b"; done
  fi
  state_clear
  head2 "Done"
  info "rebased to ${booted_n:-$want_ref} (step ${want_step:-?} complete)"
  info "rollback any time with '$PROG --rollback'; backups above are the only $HOME changes this tool made."
}

# --------------------------------------------------------------------------- #
# status / rollback
# --------------------------------------------------------------------------- #

cmd_status() {
  load_deployments
  head2 "System"
  info "distro     $(os_release_value NAME) $(os_release_value VERSION_ID)"
  info "deployment $BOOTED_REF ($BOOTED_VERSION)"
  info "staged     $([[ $STAGED_COUNT -gt 0 ]] && echo yes || echo no)  deployments: $DEPLOY_COUNT"
  info "display-mgr $(dm_current)"
  head2 "Rebase state"
  if state_get target >/dev/null 2>&1; then
    info "target  $(state_get target)"
    info "ref     $(state_get ref)"
    info "digest  $(state_get digest)"
    info "step    $(state_get step) (1 = unsigned applied, 2 = signed applied)"
    case "$(state_get step)" in
    1) info "next: reboot, then '$PROG --continue'" ;;
    2) info "next: '$PROG --finish' if you have not adopted /etc/skel yet" ;;
    esac
  else
    info "none"
  fi
}

cmd_rollback() {
  load_deployments
  am_root || die "rollback needs root: re-run as 'sudo $PROG --rollback'"
  if [[ $DEPLOY_COUNT -lt 2 ]]; then
    die "there is only one deployment; nothing to roll back to."
  fi
  head2 "Rollback"
  info "current: $BOOTED_REF ($BOOTED_VERSION)"
  info "this boots the previous deployment; \$HOME changes made by --finish are NOT undone"
  if ((${#BACKUPS[@]})); then info "backups: ${BACKUPS[*]}"; fi
  confirm "Roll back to the previous deployment?" || die "aborted; nothing was changed."
  if have "$RPM_OSTREE"; then run "$RPM_OSTREE" rollback; else run "$BOOTC" rollback; fi
  state_clear
  head2 "Next"
  info "reboot to boot the previous deployment."
}

# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #

usage() {
  cat <<EOF
$PROG $HURUBASE_VERSION — safe rebase helper for hurunagus images and other atomic Fedora/bootc distros

Usage:
  $PROG --list                          list known targets
  $PROG <target> [options]              preflight, plan, then apply
  $PROG --image <ref> [options]         same, for an arbitrary image reference
  $PROG --continue                      second half of a two-step rebase (after reboot)
  $PROG --finish [options]              after the reboot: adopt the new desktop's /etc/skel
  $PROG --status                        current deployment and rebase state
  $PROG --rollback                      boot the previous deployment
  $PROG --help | --version

Options:
  --check                preflight and print the plan, change nothing, ask nothing
  --yes                  skip the confirmation prompt
  --dry-run              print the commands instead of running them
  --image <ref>          rebase to an arbitrary image reference
  --force                continue even if the resolved digest moved since step 1
  --adopt-differs        with --finish: back up and replace files that differ
  --no-adopt             with --finish: skip the /etc/skel adoption entirely (session fix only)
  --fix-session          with --finish: reset the recorded session to the target's (root)
  --min-free-var <MiB>   free space the preflight demands on /var (default $MIN_FREE_VAR_MB)

Targets: $(variant_names | paste -sd' ' -)
Refused by design: any *-nvidia* image.
EOF
}

main() {
  local target="" ref="" check=0
  while (($#)); do
    case "$1" in
    --list | -l)
      variant_list
      return 0
      ;;
    --help | -h)
      usage
      return 0
      ;;
    --version | -V)
      say "$PROG $HURUBASE_VERSION"
      return 0
      ;;
    --check) check=1 ;;
    --yes | -y) ASSUME_YES=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --force) FORCE=1 ;;
    --continue) COMMAND=continue ;;
    --finish) COMMAND=finish ;;
    --status) COMMAND=status ;;
    --rollback) COMMAND=rollback ;;
    --adopt-differs) ADOPT_DIFFERS=1 ;;
    --no-adopt) ADOPT=0 ;;
    --fix-session) FIX_SESSION=1 ;;
    --min-free-var)
      shift
      [[ ${1:-} =~ ^[0-9]+$ ]] || usage_die "--min-free-var needs a number of MiB"
      MIN_FREE_VAR_MB=$1
      ;;
    --image)
      shift
      [[ -n ${1:-} ]] || usage_die "--image needs a reference"
      ref=$1
      ;;
    -*) usage_die "unknown option: $1" ;;
    *)
      [[ -z $target ]] || usage_die "one target at a time (got '$target' and '$1')"
      target=$1
      ;;
    esac
    shift
  done

  case "${COMMAND:-}" in
  continue) cmd_continue; return $? ;;
  finish)
    FINISH_TARGET=$target
    cmd_finish
    return $?
    ;;
  status)
    cmd_status
    return $?
    ;;
  rollback)
    cmd_rollback
    return $?
    ;;
  esac

  if [[ -z $ref ]]; then
    if [[ -z $target ]]; then
      usage
      return 2
    fi
    variant_load "$target" || die "unknown target '$target' (see '$PROG --list')"
    ref=$V_REF
  else
    is_nvidia_ref "$ref" && { err "NVIDIA images are not supported by this tool: $ref"; return 1; }
    validate_ref "$ref" || die "'$ref' does not look like an image reference (registry/owner/name[:tag])"
    local repo
    repo=$(repo_of_ref "$ref")
    # Known repository: adopt its desktop/display-manager facts.
    local n
    for n in $(variant_names); do
      variant_load "$n" || continue
      [[ $(repo_of_ref "$V_REF") == "$repo" ]] && break
    done
    [[ $(repo_of_ref "$V_REF") == "$repo" ]] || {
      V_NAME=$(normalize_ref "$ref") V_DE="unknown" V_DM="unknown" V_SESSION="" V_APPLY="rpm-ostree" \
        V_DESC="unknown image (not in the target table)" V_NOTES="" V_KEEP=""
      add_warning "this image is not in the target table, so its desktop and display manager are unknown: the preflight reports what the running system has and the apply path is decided from policy.json alone."
    }
  fi

  load_deployments
  if ! inspect_target "$(normalize_ref "$ref")"; then
    die "cannot resolve $ref (registry unreachable, wrong name, or a private image) — refusing to rebase blind."
  fi
  preflight "$(normalize_ref "$ref")"
  print_findings

  if [[ $check == 1 ]]; then
    if ((${#REFUSALS[@]})); then return 1; fi
    say ""
    say "Preflight only (--check): nothing was changed."
    return 0
  fi

  if ((${#REFUSALS[@]})); then
    die "refusing to rebase: see the refusals above."
  fi
  do_apply "$(normalize_ref "$ref")"
}

main "$@"
