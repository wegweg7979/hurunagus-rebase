variant_names() {
  printf '%s\n' \
    hurunagus-hyprland hurunagus-ublue hurunagus-silverblue \
    zirconium zirconium-jackrabbit \
    bluefin bazzite bazzite-gnome aurora kinoite ublue-silverblue
